{
  "name": "@cabmate/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "os": [
    "win32",
    "linux"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build:exe": "bun build --compile --target=bun-windows-x64 src/index.ts --windows-icon=icon.ico --outfile dist/cabmate-agent.exe",
    "build:linux": "bun build --compile --target=bun-linux-x64 src/index.ts --outfile dist/cabmate-agent",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cabmate/shared": "workspace:*",
    "koffi": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
