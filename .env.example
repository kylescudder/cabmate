# Copy to .env in the repo root; root Bun scripts load it for all workspaces.
DATABASE_URL=postgres://ets2:ets2@127.0.0.1:5439/ets2
# Herman mounts a runtime-role password file instead of placing it in the URL.
# DATABASE_PASSWORD_FILE=/run/secrets/database_password
APP_ORIGIN=http://localhost:3000
PORT=3000
# Public key is embedded by Vite at build time (GitHub repo variable for releases)
# and must also be set at runtime for Clerk's server middleware. Secret key is server-only.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/login
CLERK_SIGN_UP_URL=/login
# Local simulator only; copy your own disposable profile's API key.
# AGENT_API_KEY=
# INGEST_URL=http://localhost:3000/api/ingest
