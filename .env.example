# Copy to .env in the repo root; root Bun scripts load it for all workspaces.
DATABASE_URL=postgres://cabmate@127.0.0.1:5439/cabmate
# Herman mounts a runtime-role password file instead of placing it in the URL.
# DATABASE_PASSWORD_FILE=/run/secrets/database_password
APP_ORIGIN=http://localhost:3000
PORT=3000
# Better Auth settings (required; the app refuses to serve pages without them).
# BETTER_AUTH_SECRET: at least 32 random characters, stable across releases.
# AUTH_ALLOWED_EMAILS: comma-separated; Cabmate is invite-only.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BREVO_API_KEY=
AUTH_EMAIL_FROM=
AUTH_EMAIL_DAILY_LIMIT=40
AUTH_ALLOWED_EMAILS=
# Local simulator only; copy your own disposable profile's API key.
# AGENT_API_KEY=
# INGEST_URL=http://localhost:3000/api/ingest

# Private, read-only station state. Never put relay tokens in the web app.
RADIO_ORIGIN=http://radio-max:8080
